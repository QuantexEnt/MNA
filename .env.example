# Copy this file to .env and fill in your real values.
# .env must NEVER be committed to Git (it's in .gitignore already).

OPENAI_API_KEY=your_api_key_here

# Optional: set to "true" during development to use fake transcript/MOM
# responses instead of calling the real OpenAI API (saves cost while
# building UI/workflow). See DECISIONS.md #051.
OPENAI_MOCK=false
